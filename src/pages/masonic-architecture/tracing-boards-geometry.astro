      <!-- ARTICLE HEADER -->
      <header class="entry-header reveal">
        <span class="section-eyebrow">Pillar 5: Temple Physics</span>
        <h1 class="entry-title" style="margin-bottom: 25px;">Tracing Boards &amp; Geometry: The Visual Interface</h1>
        <p style="font-family: var(--font-prose); font-size: 1.35rem; color: var(--shsq-parchment); font-style: italic; line-height: 1.8;">
